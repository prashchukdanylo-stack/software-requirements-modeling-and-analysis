@startuml
title UC01 / Scenario 1.1: Successful lesson booking and payment via Monobank

actor "Student" as Student
participant "API Gateway" as Gateway
participant "Booking Service" as BookingService
participant "Payment Service" as PaymentService
participant "Monobank API" as MonobankAPI
database "PostgreSQL" as DB

== Booking creation (steps 1-7) ==

Student -> Gateway: POST /api/v1/bookings (lessonId)
activate Gateway

Gateway -> Gateway: validateToken(authToken)
activate Gateway
deactivate Gateway

Gateway -> BookingService: createBooking(studentId, lessonId)
activate BookingService

group transaction: lesson row is locked until commit
    BookingService -> DB: getLessonCapacity(lessonId)
    activate DB
    DB --> BookingService: maxCapacity, hallCapacity
    deactivate DB

    BookingService -> DB: countActiveBookings(lessonId)
    activate DB
    DB --> BookingService: activeCount
    deactivate DB

    BookingService -> BookingService: hasFreeSlots(min(maxCapacity, hallCapacity), activeCount)
    activate BookingService
    deactivate BookingService
    note right: precondition of 1.1: activeCount < capacity\n(active = confirmed + pending_payment)\notherwise see Scenario 1.2

    BookingService -> DB: saveBooking(studentId, lessonId, status=pending_payment)
    activate DB
    DB --> BookingService: bookingId
    deactivate DB
end

BookingService -> PaymentService: initPaymentSession(bookingId)
activate PaymentService

PaymentService -> DB: getLessonPriceByBooking(bookingId)
activate DB
DB --> PaymentService: amount
deactivate DB

PaymentService -> MonobankAPI: createInvoice(amount, reference=bookingId)
activate MonobankAPI
MonobankAPI --> PaymentService: 200 OK (invoiceId, pageUrl)
deactivate MonobankAPI

PaymentService -> DB: savePayment(bookingId, invoiceId, amount, status=pending_payment)
activate DB
DB --> PaymentService: paymentId
deactivate DB

PaymentService --> BookingService: paymentSessionCreated(pageUrl)
deactivate PaymentService

BookingService --> Gateway: 201 Created (bookingId, pageUrl)
deactivate BookingService

Gateway --> Student: 201 Created (redirect to pageUrl)
deactivate Gateway

== Payment (step 8) ==

Student -> MonobankAPI: pay(invoiceId) in Monobank app
activate MonobankAPI
MonobankAPI --> Student: payment accepted
deactivate MonobankAPI

== Webhook processing (steps 9-10) ==

MonobankAPI -> PaymentService: POST /api/webhooks/monobank (X-Sign, payload)
activate PaymentService

PaymentService -> PaymentService: verifyEcdsaSha256(xSign, payload)
activate PaymentService
deactivate PaymentService

alt signature is invalid
    PaymentService --> MonobankAPI: 400 Bad Request
else signature is valid
    PaymentService -> DB: findPaymentByInvoiceId(invoiceId)
    activate DB
    DB --> PaymentService: paymentId, bookingId, bookingStatus
    deactivate DB

    alt bookingStatus = confirmed (repeated webhook)
        PaymentService --> MonobankAPI: 200 OK (idempotent, no changes)
    else bookingStatus = pending_payment and payload.status = success
        group transaction
            PaymentService -> DB: confirmPayment(paymentId, bookingId)
            activate DB
            DB --> PaymentService: payment=confirmed, booking=confirmed
            deactivate DB
        end
        PaymentService --> MonobankAPI: 200 OK
        PaymentService -> Student: sendMessage("Бронювання підтверджено")

        else bookingStatus = pending_payment and payload.status != success
        note right: see Scenario 1.3
    end
end

deactivate PaymentService
@enduml