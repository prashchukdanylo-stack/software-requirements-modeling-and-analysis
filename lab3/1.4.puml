@startuml
title UC01 / Scenario 1.4: Student cancels booking


actor "Student" as Student
participant "Booking Timeout Worker" as Worker
participant "API Gateway" as Gateway
participant "Booking Service" as BookingService
database "PostgreSQL" as DB


Student -> Gateway: DELETE /api/v1/bookings/{booking_id}
activate Gateway

Gateway -> Gateway: validateToken(authToken)
Gateway -> BookingService: cancelBookingByUser(student_id, booking_id)
activate BookingService

BookingService -> DB: BEGIN; SELECT status, lesson_id FROM bookings \n WHERE id = :booking_id AND student_id = :student_id FOR UPDATE
activate DB

DB --> BookingService: booking_record(status = 'confirmed' or 'pending_payment')
deactivate DB

BookingService -> DB: UPDATE bookings SET status = 'cancelled' \n WHERE id =:booking_id; COMMIT

activate DB

DB --> BookingService: status_updated_to_cancelled
deactivate DB

alt booking status was 'confirmed'
BookingService -> DB: BEGIN; UPDATE lessons SET current_bookings = cuurent_bookings -1 \n WHERE id = :lesson_id; COMMIT
activate DB

DB --> BookingService: slots_freed
deactivate DB

else booking status was 'pending_payment'
note over BookingService: Slot was only in pending state, no active count to decrement
end

opt manual refund required (out of scope)

BookingService -> BookingService: addManualRefundInstructionNote()
end

BookingService --> Gateway: 200 OK(booking cancelled successfully)
deactivate BookingService

Gateway --> Student: 200 OK ("Бронювання скасовано. Для повернення коштів зверніться до адміністрації.")
deactivate Gateway
@enduml
