@startuml
title UC01 / Scenario 1.4: Student cancels booking

actor "Student" as Student
participant "API Gateway" as Gateway
participant "Booking Service" as BookingService
participant "Payment Service" as PaymentService
participant "Monobank API" as MonobankAPI
database "PostgreSQL" as DB

Student -> Gateway: DELETE /api/v1/bookings/{bookingId}
activate Gateway

Gateway -> Gateway: validateToken(authToken)
activate Gateway
deactivate Gateway

Gateway -> BookingService: cancelBookingByUser(studentId, bookingId)
activate BookingService

group transaction: booking row is locked until commit
    BookingService -> DB: findBookingForStudent(bookingId, studentId)
    activate DB
    DB --> BookingService: bookingStatus (or not found)
    deactivate DB

    alt booking not found or belongs to another student
        BookingService --> Gateway: 404 Not Found
        Gateway --> Student: 404 Not Found
    else bookingStatus = cancelled
        BookingService --> Gateway: 409 Conflict (already cancelled)
        Gateway --> Student: 409 Conflict ("Бронювання вже скасовано")
    else bookingStatus = pending_payment
        BookingService -> DB: cancelBookingAndPayment(bookingId, paymentStatus = cancelled)
        activate DB
        DB --> BookingService: cancelled
        deactivate DB

        BookingService -> PaymentService: cancelInvoice(bookingId)
        activate PaymentService

        PaymentService -> DB: findInvoiceByBooking(bookingId)
        activate DB
        DB --> PaymentService: invoiceId, studentId
        deactivate DB

        PaymentService -> MonobankAPI: cancelInvoice(invoiceId)
        activate MonobankAPI
        MonobankAPI --> PaymentService: 200 OK
        deactivate MonobankAPI

        PaymentService --> BookingService: invoiceCancelled
        deactivate PaymentService

        BookingService --> Gateway: 200 OK (booking cancelled)
        Gateway --> Student: 200 OK ("Бронювання скасовано")
    else bookingStatus = confirmed
        BookingService -> DB: cancelBooking(bookingId)
        activate DB
        DB --> BookingService: cancelled
        deactivate DB
        note right: payments.status stays confirmed:\nmoney was charged, refund is manual

        BookingService --> Gateway: 200 OK (booking cancelled, refund is manual)
        Gateway --> Student: 200 OK ("Бронювання скасовано. Для повернення коштів зверніться до адміністрації.")
    end
end

deactivate BookingService
deactivate Gateway
@enduml