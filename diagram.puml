@startuml

entity Instructor {
    * id : uuid <<PK>>
    --
    * first_name : string
    * last_name : string
    * email : string
    * phone : string
    bio : string
    * hired_at : datetime
}

entity Student {
    * id : uuid <<PK>>
    --
    * first_name : string
    * last_name : string
    * email : string
    * phone : string
    * registered_at : datetime
}

entity DanceStyle {
    * id : uuid <<PK>>
    --
    * name : string
    description : string
}

entity Hall {
    * id : uuid <<PK>>
    --
    * name : string
    * capacity : int
}

entity Lesson {
    * id : uuid <<PK>>
    --
    * instructor_id : uuid <<FK>>
    * hall_id : uuid <<FK>>
    * dance_style_id : uuid <<FK>>
    * start_time : datetime
    * end_time : datetime
    * max_capacity : int
}

entity Booking {
    * id : uuid <<PK>>
    --
    * student_id : uuid <<FK>>
    * lesson_id : uuid <<FK>>
    * booked_at : datetime
    * status : string
}

Instructor }|--|{ DanceStyle
Hall ||--o{ Lesson
Instructor ||--o{ Lesson
DanceStyle ||--o{ Lesson
Student ||--o{ Booking
Lesson ||--o{Booking

@enduml