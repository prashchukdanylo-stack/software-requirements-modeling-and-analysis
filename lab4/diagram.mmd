flowchart TB
  subgraph ST["Student"]
    S0(("Start")) --> S1["Choose lesson,<br/>press 'Book and pay'"]
    S1 --> S2>"SEND: booking request"]
    S2 -. "no response" .-> S2E["Show 'connection error / timeout'<br/>(DB unchanged)"]
    S2E --> E0(("End:<br/>no booking"))
    S3["ACCEPT: error 'Class is full'"] --> E1(("End:<br/>rejected"))
    S5["ACCEPT: redirect,<br/>open Monobank payment page"] --> S6["Approve payment<br/>in Monobank app"]
    S6 --> S7>"SEND: transaction approval"]
    S8["ACCEPT: booking confirmation"] --> E2(("End:<br/>confirmed"))
    S9["ACCEPT: cancellation notice"] --> E3(("End:<br/>cancelled"))
  end

  subgraph CRM["CRM-system"]
    C1["ACCEPT: booking request"] --> C2{"Slots available?<br/>confirmed + pending_payment<br/>&lt; Hall.capacity and Lesson.max_capacity"}
    C2 -- "No" --> C3>"SEND: 409 Conflict, Class is full"]
    C2 -- "Yes" --> C4["Create Booking in DB<br/>status = pending_payment,<br/>created_at = now, block slot"]
    C4 --> C5>"SEND: payment session request<br/>(with bookingId)"]
    C5 -. "no response / error" .-> C6
    C7["ACCEPT: payment link"] --> C8>"SEND: redirect to payment link"]
    
    C8 --> F1["━━ FORK ━━<br/>(Async parallel paths)"]
    
    F1 --> W["Branch A: Wait for Webhook"]
    
    W --> C10["ACCEPT: Webhook"]
    C10 --> V{"Signature valid<br/>SHA-256/ECDSA?"}
    V -- "No" --> R400>"SEND: HTTP 400 Bad Request<br/>(Log invalid signature)"] --> W
    
    V -- "Yes" --> S{"Check current<br/>Booking status"}
    
    S -- "confirmed" --> R200A["Idempotent duplicate:<br/>SEND: HTTP 200 OK<br/>(No state change)"] --> W
    

    S -- "cancelled" --> R200B["Late Webhook after timeout:<br/>Log for manual refund<br/>SEND: HTTP 200 OK"] --> W
    
    S -- "pending_payment" --> D{"Webhook status<br/>= success?"}
    
    D -- "Yes" --> CONF["Booking = confirmed"]
    CONF --> N1>"SEND: success notification &<br/>SEND: HTTP 200 OK"]
    
    D -- "No (err_declined)" --> C6
    
    C6["Booking = cancelled,<br/>release slot"] --> N2>"SEND: cancellation notice &<br/>SEND: HTTP 200 OK"]
  end

  subgraph WK["BookingTimeoutWorker"]
    F1 -.-> W1["Branch B: Loop every 1 min:<br/>findExpiredBookings"]
    W1 --> W2>"SEND: cancelExpiredBookings"]
    W2 --> W3["ACCEPT: cleanupCompleted"]
  end

  subgraph MB["Monobank API"]
    M1["ACCEPT: session request"] --> M2{"Session created?"}
    M2 -- "Yes" --> M3>"SEND: payment link"]
    M2 -- "No" --> M4>"SEND: error"]
    M5["ACCEPT: transaction approval"] --> M6["Process card transaction"]
    M6 --> M7>"SEND: async Webhook (status)"]
    M8["ACCEPT: cancelInvoice"] --> M9["Invoice cancelled"]
  end

  S2 --> C1
  C3 --> S3
  C5 --> M1
  M3 --> C7
  M4 --> C6
  C8 --> S5
  S7 --> M5
  M7 --> C10
  N1 --> S8
  N2 --> S9
  W2 --> C6
  C6 --> W3
  C6 --> M8