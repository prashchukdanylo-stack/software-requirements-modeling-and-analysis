@startuml
title UC01 / Scenario 1.3: Cancelling booking after timeout or payment error


actor "Student" as Student
participant "Booking Timeout Worker" as Worker
participant "Payment Service" as PaymentService
participant "Monobank API" as MonobankAPI
participant "Booking Service" as BookingService
database "PostgreSQL" as DB

alt trigger: Payment failure received from Monobank API with status err_declined
    MonobankAPI -> PaymentService: POST /api/webhooks/monobank (X-Sign, payload)
    activate PaymentService

    PaymentService -> PaymentService: verifyEcdsaSha256(xSign, payload)
    activate PaymentService
    deactivate PaymentService

    alt signature is invalid
        PaymentService --> MonobankAPI: 400 Bad Request
    else signature is valid
        PaymentService -> DB: findPaymentByInvoiceId(invoiceId)
        activate DB
        DB --> PaymentService: paymentId, bookingId, bookingStatus
        deactivate DB 

        opt bookingStatus = pending_payment
            PaymentService -> BookingService: cancelBooking(bookingId, reason = payment_declined)
            activate BookingService
            group transaction
                BookingService -> DB: cancelBookingAndPayment(bookingId, paymentStatus = cancelled)
                activate DB
                DB --> BookingService: cancelled
                deactivate DB
            end
            BookingService --> PaymentService: bookingCancelled
            deactivate BookingService
            PaymentService -> Student: sendMessage("Оплата не пройшла, бронювання скасовано")
        end
        PaymentService --> MonobankAPI: 200 OK
    end
    deactivate PaymentService
else trigger: 15-minute payment window expired (NFR-04, REQ-05)
    activate Worker
    loop every minute
        Worker -> DB: findExpiredBookings(olderThan = 15 min, status = pending_payment)
        activate DB
        DB --> Worker: expiredBookings
        deactivate DB

        opt expiredBookings is not empty
            Worker -> BookingService: cancelExpiredBookings(expiredBookingIds)
            activate BookingService

            group transaction
                BookingService -> DB: cancelBookings(expiredBookingIds, paymentStatus = expired)
                activate DB
                DB --> BookingService: cancelled
                deactivate DB
            end

            loop for each expired booking
                BookingService -> PaymentService: cancelInvoice(invoiceId, studentId)
                activate PaymentService
                PaymentService -> MonobankAPI: cancelInvoice(invoiceId)
                activate MonobankAPI
                MonobankAPI --> PaymentService: 200 OK
                deactivate MonobankAPI
                PaymentService -> Student: sendMessage("Час оплати минув, бронювання скасовано")
                PaymentService --> BookingService: invoiceCancelled
                deactivate PaymentService
            end

            BookingService --> Worker: cleanupCompleted
            deactivate BookingService
        end
    end
    
    deactivate Worker
end
@enduml
